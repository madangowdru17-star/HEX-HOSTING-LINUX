# NE-HOST — environment configuration
# Copy this file to `.env` and fill in real values before deploying.
# Never commit your actual `.env` file to version control.

# --- Core ---
FLASK_ENV=production
# FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# --- Secrets (REQUIRED in production) ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Bootstrap admin account (used only on first run, to create the
# admin_settings row; ignored on every run after that) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Cookies ---
# Set to true once you are serving over HTTPS (recommended in production)
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=43200

# --- Uploads ---
MAX_UPLOAD_MB=50

# --- Login / brute-force protection ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
GLOBAL_RATE_LIMIT_PER_MIN=120

# --- GitHub repository import ---
GITHUB_IMPORT_ENABLED=true
GITHUB_IMPORT_MAX_MB=200
GITHUB_IMPORT_TIMEOUT_SECONDS=60

# --- Reverse proxy ---
# Only set to true if you run this behind a reverse proxy/load balancer
# that you control and that sets X-Forwarded-For itself (otherwise this
# header is spoofable and MUST stay false).
TRUST_PROXY_HEADERS=false
